# Odoo Environment Configuration
ODOO_VERSION=19.0
POSTGRES_DB=postgres
DB_USER=odoo
DB_PASSWORD=odoo
DEBUGPY_PORT=5679

# Lokal nur die DEV-Container starten (Profile siehe docker-compose.yml)
COMPOSE_PROFILES=dev
# Lokal zusätzlich Ports für localhost:8069 (siehe docker-compose.local.yml)
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.local.yml
